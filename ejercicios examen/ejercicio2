
#"num_serie": ["titulo", "plataforma", "genero", "clasificacion", "original"]
peliculas = {
'S001': ['Stranger Things', 'Netflix', 'Ciencia Ficcion', 'TEEN', True],
'S002': ['The Mandalorian', 'Disney+', 'Sci-Fi', 'TEEN', False],
'S003': ['The Boys', 'Prime Video', 'Accion', '18+', False]
}

#"num_serie": ["precio_arriendo", "reproducciones"]
metricas = {
'S001': [0, 450],
'S002': [2500, 120],
'S003': [0, 890]
}

def validar_titulo(titulo):
    return len(titulo.strip()) > 0

def validar_plataforma(plataforma):
    return len(plataforma.strip()) > 0

def validar_genero(genero):
    return len(genero.strip()) > 0

def validar_clasificacion(clasificacion):
    return clasificacion.upper() in ("TEEN", "18+")

def validar_original(original):
    return original.lower() in ("s", "n")

def validar_precio(precio):
    return isinstance(precio, int) >= 0
    
def validar_reproducciones(repro):
    return isinstance(repro, int) >= 0

def total_reproducciones(plataforma):
    plataforma_buscado = plataforma.lower()
    total = 0

    for codigo, datos in peliculas.items():
        if datos[1].lower() == plataforma_buscado:
            cantidad_reproducciones = metricas[codigo][1]
            total += cantidad_reproducciones

    print(f"El total de reproducciones en la plataforma '{plataforma}' es: {total}")

def buscar_por_visitas(min_vistas, max_vistas):
    if min_vistas < 0 or max_vistas < 0 or min_vistas > max_vistas:
        return
    
    cantidad = []

    for codigo, datos in metricas.items():
        vistas_serie = datos[1]

        if min_vistas <= vistas_serie <= max_vistas:
            formato = (f"{datos[1]} -- {codigo}")
            cantidad.append(formato)

    if not cantidad:
        print("No hay series en ese rango de reproducciones.")
    else:
        cantidad.sort()
        print("=== SERIES ENCONTRADAS ===")
        for item in cantidad:
            print(item)

def actualizar_precio(codigo, nuevo_precio):
    
    for llave in metricas.items():
        if codigo == llave:
            metricas[llave][0] = nuevo_precio
            return True
        return False
    
def eliminar_serie(codigo):

    codigo_validado = codigo.upper()

    for llave in peliculas.items():
        if codigo_validado == llave:
            del peliculas[codigo_validado]
            del metricas[codigo_validado]
            return True
        return False

